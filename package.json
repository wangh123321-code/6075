    "react-dom": "^18.3.1",
    "react-router-dom": "^7.3.0",
    "tailwind-merge": "^3.0.2",
    "zustand": "^5.0.3",
    "express": "^4.21.2",
    "@babylonjs/core": "^6.41.0",
    "@babylonjs/havok": "^1.3.7",
    "@babylonjs/materials": "^6.41.0",
    "@babylonjs/post-processes": "^6.41.0",
    "@babylonjs/procedural-textures": "^6.41.0",
